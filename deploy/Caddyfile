# HTTPS reverse proxy. Requires a public DNS record for DOMAIN.
# Never commit production secrets or use a demo hostname with learner data.
{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    -Server
  }
  reverse_proxy api:8000 {
    health_uri /healthz
    health_interval 30s
  }
}
